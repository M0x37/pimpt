{
  "name": "@m0x373/pimpt",
  "version": "0.1.3",
  "description": "Interactive setup assistant for Windows Terminal",
  "type": "module",
  "bin": {
    "pimpt": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "windows-terminal",
    "cli",
    "customization",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  }
}
